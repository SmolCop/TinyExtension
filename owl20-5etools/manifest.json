{
  "manifest_version": 3,
  "name": "Tiny Extension",
  "version": "1.2.0",
  "description": "Bridges dice rolls from 5etools to Owl20 on Owlbear Rodeo",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.owlbear.rodeo/*",
    "https://owlbear.rodeo/*",
    "*://*.5e.tools/*",
    "*://5e.tools/*",
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.owlbear.rodeo/*",
        "https://owlbear.rodeo/*"
      ],
      "js": ["content-obr.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://*.5e.tools/*",
        "*://5e.tools/*",
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*"
      ],
      "js": ["statblock-reader.js", "content-5etools.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tiny Extension",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
